{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperKit",
  "version": "0.2.0",
  "identifier": "app.paperkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PaperKit",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/tessdata/": "tessdata/",
      "resources/fonts/": "fonts/"
    },
    "category": "Productivity",
    "shortDescription": "Offline PDF toolkit: split, merge, redact, edit, convert",
    "longDescription": "Split, merge, redact (with on-device AI), edit and convert PDFs. Everything runs on your computer; files never leave it.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDMjE0QjE2QTJDNkIwQTYKUldTbXNNYWlGa3NoN0pSamNsdXZ2UXVWdTFmMFl6N2hhRGdPTkwwTVNKaEVMVnhoQlZKcmdGSnEK",
      "endpoints": [
        "https://github.com/oulismi/Paperkit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
